{
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:3000} {
	log {
		format json
	}

	root * .
	encode gzip
	file_server

	# Any path that isn't a real file (e.g. /verify/POA-072026-03, /portal,
	# /admin) falls back to index.html, which decides what to show client-side.
	try_files {path} /index.html

	# Security headers (audit finding 7). Enforcing.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://synezhkrfwnxmegunyjk.supabase.co wss://synezhkrfwnxmegunyjk.supabase.co; frame-src data: blob: https://www.youtube.com https://player.vimeo.com; media-src 'self' data: blob: https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000"
		Cache-Control "no-cache"
		-Server
	}
}
